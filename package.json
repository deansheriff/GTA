{
  "name": "naija-street-life",
  "private": true,
  "version": "0.0.1",
  "description": "Naija Street Life — Nigerian life-sim and comedy-crime game for Android (Godot). Story mode: Up NEPA!",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @nsl/server",
    "build": "npm run build -w @nsl/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "art:gen": "node --env-file=.env tools/art/gen.mjs",
    "art:process": "node tools/art/process.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
