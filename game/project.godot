; Naija Street Life — Godot 4.6 project (decision D-005: Android-only, Compatibility renderer).

config_version=5

[application]

config/name="Naija Street Life"
config/description="A Nigerian life-sim and comedy-crime game. Story mode: Up NEPA!"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.11, 0.09, 0.07, 1)

[autoload]

Settings="*res://core/settings.gd"
Net="*res://core/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
environment/defaults/default_clear_color=Color(0.13, 0.11, 0.09, 1)

[naija]

online/default_server=""
